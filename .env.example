# Copy to .env (chmod 600). Never commit it.

# Required: any OpenAI-compatible chat endpoint that supports JSON output.
RELWORK_LLM_BASE_URL=http://127.0.0.1:8000/v1
RELWORK_LLM_MODEL=local-llm
# Bearer token, if your endpoint needs one.
RELWORK_LLM_API_KEY=

# Semantic Scholar key (default citation source). Effectively required: without one,
# a 1-hop test run hit HTTP 429 repeatedly and had not finished after 30 minutes.
RELWORK_S2_API_KEY=
# OpenAlex key, the alternative citation source. Used with `crawl --source openalex`, or
# automatically when Semantic Scholar stays down before the first node. Coverage is weaker.
RELWORK_OPENALEX_API_KEY=
# Optional: directory containing node_modules/puppeteer, for PNG export.
RELWORK_PUPPETEER_DIR=
# Optional: read-only SQLite with table papers(venue, year, title, pdf_url), for venue lookup.
RELWORK_CORPUS_DB=
